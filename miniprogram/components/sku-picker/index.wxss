/* Keep the popup visible even if page styles are isolated from this component. */
.fruit-picker-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 9998;
}

.fruit-picker-panel {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 9999;
  box-sizing: border-box;
  max-height: 80vh;
  overflow-y: auto;
  padding: 32rpx 32rpx calc(30rpx + env(safe-area-inset-bottom));
  border-radius: 32rpx 32rpx 0 0;
  background: #faf8f4;
  color: #292c25;
  font-size: 28rpx;
  line-height: 1.55;
  animation: fruit-picker-rise 0.22s ease-out;
}

.fruit-picker-panel .row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.fruit-picker-panel .left {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 20rpx;
}

.fruit-picker-panel .thumb {
  width: 130rpx;
  height: 130rpx;
  flex: 0 0 130rpx;
  overflow: hidden;
  border-radius: 16rpx;
}

.fruit-picker-panel .sheet-head {
  font-size: 33rpx;
  font-weight: 600;
}

.fruit-picker-panel .price {
  color: #d15f3b;
  font-size: 34rpx;
  font-weight: 600;
}

.fruit-picker-panel .currency {
  margin-right: 3rpx;
  font-size: 22rpx;
}

.fruit-picker-panel .muted {
  color: #939086;
  font-size: 24rpx;
}

.fruit-picker-panel .small {
  font-size: 22rpx;
}

.fruit-picker-panel .section {
  margin-top: 36rpx;
}

.fruit-picker-panel .specs {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin: 30rpx 0;
}

.fruit-picker-panel .spec {
  padding: 18rpx 24rpx;
  border: 2rpx solid #e7e3db;
  border-radius: 12rpx;
  font-size: 24rpx;
}

.fruit-picker-panel .spec.active {
  border-color: #d96b45;
  background: #fff1e9;
  color: #be5836;
}

.fruit-picker-panel .spec.disabled {
  opacity: 0.4;
}

.fruit-picker-panel .steps {
  display: flex;
  align-items: center;
  overflow: hidden;
  border: 1rpx solid #e7e3db;
  border-radius: 12rpx;
}

.fruit-picker-panel .steps button {
  width: 62rpx;
  height: 60rpx;
  margin: 0;
  padding: 0;
  background: #faf9f6;
  font-size: 30rpx;
  line-height: 60rpx;
}

.fruit-picker-panel .steps text {
  min-width: 56rpx;
  text-align: center;
}

.fruit-picker-panel .close {
  width: 64rpx;
  height: 64rpx;
  margin: 0;
  padding: 0;
  border-radius: 50%;
  background: #eeebe4;
  line-height: 64rpx;
}

.fruit-picker-panel .sheet-action {
  display: block;
  width: 100%;
  min-width: 0;
  height: 88rpx;
  margin-top: 32rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: #d96b45;
  color: #fff;
  line-height: 88rpx;
}

@keyframes fruit-picker-rise {
  from {
    transform: translateY(40rpx);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}
