:host {
  display: block;
  width: 100%;
  height: 100%;
}
.frame {
  position: relative;
  overflow: hidden;
  width: 100%;
  height: 100%;
  background: #f1ede5;
}
.sheet {
  position: absolute;
  width: 400%;
  height: 300%;
  max-width: none;
}
.fallback {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  color: #a19c91;
  font-size: 24rpx;
  gap: 12rpx;
}
