.profile {
  display: flex;
  gap: 24rpx;
  align-items: center;
  padding: 22rpx 0 45rpx;
}
.avatar {
  width: 108rpx;
  height: 108rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: #eaeddf;
  color: #7e876a;
  display: flex;
  align-items: center;
  justify-content: center;
}
.greeting {
  font-size: 37rpx;
  margin-bottom: 10rpx;
}
.no-margin {
  margin: 0;
}
.order-card > .row > .text-btn {
  display: flex;
  flex: 0 0 auto;
  width: auto;
  min-width: 150rpx;
  align-items: center;
  justify-content: flex-end;
  gap: 4rpx;
  padding: 0;
  margin: 0;
  font-size: 25rpx;
  font-weight: 400;
  line-height: 1.4;
  white-space: nowrap;
}
.order-card > .row > .text-btn > text {
  flex: 0 0 auto;
}
.order-card > .row > .text-btn > t-icon {
  flex: 0 0 auto;
}
.order-shortcuts {
  display: flex;
  margin-top: 40rpx;
  margin-bottom: 12rpx;
}
.order-shortcuts > view {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  gap: 13rpx;
  font-size: 23rpx;
  color: #777d68;
}
.number {
  position: absolute;
  top: -8rpx;
  right: 35rpx;
  font-size: 18rpx;
  background: #d86b43;
  color: white;
  border-radius: 50%;
  min-width: 25rpx;
  text-align: center;
}
.menu {
  padding: 0 28rpx;
}
.menu-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 31rpx 0;
  color: #626959;
}
.menu-row + .menu-row {
  border-top: 1rpx solid #eeece4;
}
.store-info {
  text-align: center;
  margin: 65rpx 0 35rpx;
}
.store-info .eyebrow {
  font-size: 16rpx;
  letter-spacing: 2rpx;
}
.store-name {
  font-size: 35rpx;
  margin: 16rpx 0;
}
.store-info .muted {
  font-size: 22rpx;
}
.store-hours {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 8rpx;
  color: #929482;
  font-size: 23rpx;
  margin: 22rpx 0 8rpx;
}
.text-btn.demo-entry {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  width: 160rpx;
  min-width: 140rpx;
  flex: 0 0 auto;
  padding: 12rpx 0;
  white-space: nowrap;
  margin: 45rpx auto 0;
  font-size: 21rpx;
  color: #b3b0a6;
}
