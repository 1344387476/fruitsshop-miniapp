.home {
  padding-top: 10rpx;
}
.shop-note {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 20rpx;
  color: #8a8c80;
  margin: 10rpx 0 28rpx;
}
.open-dot {
  width: 9rpx;
  height: 9rpx;
  border-radius: 50%;
  background: #8b976c;
}
.delivery {
  margin-left: auto;
}
.hero {
  height: 365rpx;
  border-radius: 24rpx;
  background: #eeeade;
  position: relative;
  overflow: hidden;
}
.hero-copy {
  position: relative;
  z-index: 2;
  padding: 34rpx;
}
.hero .eyebrow {
  font-size: 17rpx;
  color: #8a9079;
  letter-spacing: 3rpx;
}
.hero-title {
  font-size: 49rpx;
  line-height: 1.35;
  font-weight: 600;
  letter-spacing: 3rpx;
  margin-top: 15rpx;
}
.hero-sub {
  font-size: 22rpx;
  color: #8e8c7b;
  margin-top: 16rpx;
}
.hero-link {
  padding: 0;
  margin: 24rpx 0 0;
  background: transparent;
  display: flex;
  align-items: center;
  gap: 14rpx;
  font-size: 23rpx;
  line-height: 1.5;
  color: #666f51;
  text-align: left;
}
.hero-fruit {
  position: absolute;
  width: 390rpx;
  height: 390rpx;
  right: -88rpx;
  bottom: -40rpx;
  transform: rotate(-12deg);
  border-radius: 50%;
  overflow: hidden;
  mix-blend-mode: multiply;
}
.hero-stamp {
  position: absolute;
  right: 28rpx;
  top: 27rpx;
  border: 1rpx solid #a6aa92;
  border-radius: 50%;
  width: 67rpx;
  height: 67rpx;
  color: #7d8567;
  text-align: center;
  font-size: 20rpx;
  line-height: 1.25;
  padding-top: 8rpx;
  transform: rotate(10deg);
}
.promise {
  display: flex;
  justify-content: space-around;
  margin: 26rpx 0 32rpx;
  color: #8b8e7d;
  font-size: 22rpx;
}
.promise > view {
  display: flex;
  gap: 7rpx;
  align-items: center;
}
.goods-title {
  margin-top: 8rpx;
  margin-bottom: 0;
  font-size: 36rpx;
}
.category-scroll {
  white-space: nowrap;
  margin: 26rpx 0;
  width: 100%;
}
.categories {
  display: flex;
  gap: 16rpx;
}
.category {
  padding: 13rpx 25rpx;
  color: #8c8c80;
  font-size: 24rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  transition: background 0.18s;
}
.category.active {
  background: #687454;
  color: #fff;
}
.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 26rpx 20rpx;
}
.product {
  min-width: 0;
  transition: transform 0.15s;
}
.product-pressed {
  transform: scale(0.985);
}
.product-photo {
  width: 100%;
  aspect-ratio: 1;
  border-radius: 18rpx;
  overflow: hidden;
  position: relative;
}
.product-label {
  position: absolute;
  left: 14rpx;
  top: 14rpx;
  font-size: 18rpx;
  background: #fff9;
  padding: 5rpx 12rpx;
  border-radius: 6rpx;
  color: #7e8069;
}
.sold {
  position: absolute;
  inset: 0;
  background: #faf8f480;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #666;
  font-size: 24rpx;
}
.product-info {
  padding: 18rpx 5rpx 0;
}
.product-name {
  font-size: 28rpx;
  font-weight: 500;
}
.product-spec {
  font-size: 21rpx;
  margin-top: 7rpx;
}
.product-bottom {
  margin-top: 13rpx;
}
.product-bottom .price {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  white-space: nowrap;
}
.product-bottom .add {
  flex: 0 0 56rpx;
  width: 56rpx;
  min-width: 56rpx;
  max-width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0;
  margin: 0;
  background: #d86b43;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.product-bottom .add.disabled {
  background: #d2cec5;
}
.home-footer {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  color: #a4a193;
  font-size: 22rpx;
  margin: 55rpx 0 20rpx;
}
.footer-line {
  height: 1rpx;
  width: 55rpx;
  background: #dedbcf;
}
.demo-note {
  text-align: center;
  font-size: 19rpx;
  color: #b4b0a6;
}
